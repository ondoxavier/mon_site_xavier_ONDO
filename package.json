{
  "name": "portfolio-xavier",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "screenshots": "playwright test -g capture",
    "lighthouse": "npx -y lighthouse https://xavierondo.com --only-categories=performance,accessibility,best-practices,seo --output=html --output-path=./playwright-report/lighthouse.html --chrome-flags=--headless --quiet"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
